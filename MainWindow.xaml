<Window x:Class="PSS_HVCement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PSS_HVCement.Views"
        xmlns:vm="clr-namespace:PSS_HVCement.ViewModels"
        xmlns:cvt="clr-namespace:PSS_HVCement.Converter"
        xmlns:local="clr-namespace:PSS_HVCement"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1360"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <cvt:BooleanToServerStatusConverter x:Key="BooleanToServerStatusConverter"/>
        <cvt:BooleanToForegroundConverter x:Key="BooleanToForegroundConverter"/>
        <cvt:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="3*" />
            <!--<RowDefinition Height="30" />-->
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Label VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="5 2 2 2"
                   Content="{Binding IsConnectedServer, Converter={StaticResource BooleanToServerStatusConverter}}"
                   Foreground="{Binding IsConnectedServer, Converter={StaticResource BooleanToForegroundConverter}}"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Name="labelStatusServer"
                   Visibility="Hidden"/>
            <Label VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="5 2 5 2"
                   Content=""
                   FontWeight="SemiBold"
                   FontSize="12"
                   Name="labelSendData"
                   Visibility="Visible" />
            <Label VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="5 2 5 2"
                   Content=""
                   FontWeight="SemiBold"
                   FontSize="12"
                   Name="labelReceiveData"
                   Visibility="Visible" />
            <Button VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="5 2 5 2"
                    Content="Test send data"
                    Click="Button_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
        <Button VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0 2 10 2"
                Command="{Binding AboutCmd}">
            <Button.Template>
                <ControlTemplate>
                    <Grid>
                        <Image Source="/Resources/Images/info.png"
                               Height="25"
                               Width="25"
                               Cursor="Hand" 
                               ToolTip="Thông tin"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0 2 45 5"
                Name="btnLogin"
                Width="25"
                Height="25"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Opacity="1.0"
                Command="{Binding OpenLoginViewCmd}"
                CommandParameter="{Binding ElementName=tbLogin, Path=Text}">
            <Button.Content>
                <Grid>
                    <Image Source="{Binding DisplayImage_LoginStatusPath}"
                           Width="25"
                           Height="25" />
                    <TextBlock Text="LOGIN"
                               Name="tbLogin"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"/>
                </Grid>
            </Button.Content>
        </Button>
        <Button VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0 2 80 2"
                Command="{Binding OpenSettingViewCmd}"
                IsEnabled="{Binding IsAllowOperation}"
                Opacity="{Binding DOpacity}">
            <Button.Template>
                <ControlTemplate>
                    <Grid>
                        <Image Source="/Resources/Images/AccountManagement.png"
                               Height="25"
                               Width="25"
                               Cursor="Hand"
                               ToolTip="Cài đặt"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0 2 115 2"
                Command="{Binding OpenReportViewCmd}"
                IsEnabled="{Binding IsAllowOperation}"
                Opacity="{Binding DOpacity}">
            <Button.Template>
                <ControlTemplate>
                    <Grid>
                        <Image Source="/Resources/Images/report.png"
                               Height="25"
                               Width="25"
                               Cursor="Hand" 
                               ToolTip="Báo cáo"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0 2 155 2"
                Content="Reconnect"
                FontSize="12"
                Name="btnReconnet"
                Click="btnReconnet_Click"
                Visibility="Hidden">
            <Button.Template>
                <ControlTemplate>
                    <Grid>
                        <Image Source="/Resources/Images/reconnect_2.png"
                               Height="30"
                               Width="30"
                               Cursor="Hand"
                               ToolTip="KẾT NỐI LẠI SERVER" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ContentControl Grid.Row="1" x:Name="contentPrinters" />
        <ContentControl x:Name="contentData"
                        Grid.Row="2"
                        Visibility="Collapsed"/>
    </Grid>
</Window>
